PORT=5000
CLIENT_URL=http://localhost:3000

DB_SYNC_ALTER=true
# Database (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=service-trade-books
DB_USER=postgres
DB_PASSWORD=your_db_password

# Or Cloud PostgreSQL (e.g. Neon, Render)
# DATABASE_URL=postgresql://user:password@host:5432/service-trade-books?sslmode=require
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# SMTP (Email for exchange requests)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Book Exchange <noreply@bookexchange.local>"
